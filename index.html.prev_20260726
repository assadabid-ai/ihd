          <tr><td>Homogeneity</td><td class="formula">Σ p(i,j) / (1 + (i−j)²)</td></tr>
          <tr><td>Angular Second Moment</td><td class="formula">Σ p(i,j)²</td></tr>
          <tr><td>Energy</td><td class="formula">√(ASM)</td></tr>
          <tr><td>Correlation</td><td class="formula">Σ (i−μᵢ)(j−μⱼ) p(i,j) / (σᵢσⱼ)</td></tr>
        </table>
        <p class="muted" style="font-size:0.78rem;margin-top:0.4rem;">Computed on the grey-level image at multiple pixel offsets and orientations.</p>
